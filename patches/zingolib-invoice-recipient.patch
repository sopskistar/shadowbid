 pub mod data;
+
+/// Resolve a decrypted note to an address recorded by this wallet. Unknown
+/// recipients deliberately stay unknown; callers must never infer an invoice
+/// from a transaction ID or account ID alone.
+pub trait InvoiceNoteRecipient: NoteInterface {
+    fn recipient_unified_address(&self, wallet: &LightWallet) -> Option<String>;
+}
+
+impl InvoiceNoteRecipient for IronwoodNote {
+    fn recipient_unified_address(&self, wallet: &LightWallet) -> Option<String> {
+        wallet
+            .is_orchard_address_in_unified_addresses(&self.note().recipient())
+            .map(|(_, address)| address.encode(&wallet.chain_type))
+    }
+}
+
+impl InvoiceNoteRecipient for OrchardNote {
+    fn recipient_unified_address(&self, wallet: &LightWallet) -> Option<String> {
+        wallet
+            .is_orchard_address_in_unified_addresses(&self.note().recipient())
+            .map(|(_, address)| address.encode(&wallet.chain_type))
+    }
+}
+
+impl InvoiceNoteRecipient for SaplingNote {
+    fn recipient_unified_address(&self, wallet: &LightWallet) -> Option<String> {
+        wallet
+            .is_sapling_address_in_unified_addresses(&self.note().recipient())
+            .map(|(_, address)| address.encode(&wallet.chain_type))
+    }
+}
 

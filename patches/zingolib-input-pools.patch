+    #[test]
+    fn restricted_sources_never_select_another_pool() -> Result<(), WalletError> {
+        const TARGET_HEIGHT: u32 = 21;
+        const REQUESTED_VALUE: Zatoshis = Zatoshis::const_from_u64(1_000_000);
+        let wallet = funded_wallet();
+        for source in [
+            ShieldedPool::Sapling,
+            ShieldedPool::Orchard,
+            ShieldedPool::Ironwood,
+        ] {
+            for target in [
+                TargetValue::AtLeast(REQUESTED_VALUE),
+                TargetValue::AllFunds(MaxSpendMode::MaxSpendable),
+            ] {
+                let selected = wallet.select_spendable_notes(
+                    zip32::AccountId::ZERO,
+                    target,
+                    &[source],
+                    TargetHeight::from(TARGET_HEIGHT),
+                    ConfirmationsPolicy::new_symmetrical(NonZeroU32::MIN, false),
+                    &[],
+                    LockFilter::Unfiltered,
+                )?;
+                assert_eq!(
+                    !selected.sapling().is_empty(),
+                    source == ShieldedPool::Sapling
+                );
+                assert_eq!(
+                    !selected.orchard().is_empty(),
+                    source == ShieldedPool::Orchard
+                );
+                assert_eq!(
+                    !selected.ironwood().is_empty(),
+                    source == ShieldedPool::Ironwood
+                );
+            }
+        }
+        Ok(())
+    }
+

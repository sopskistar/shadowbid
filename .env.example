# Web application: Neon pooled PostgreSQL URL in Vercel; local PostgreSQL URL in development.
DATABASE_URL=
# Shared HMAC secret and checkout-token encryption key. Generate >=32 random characters.
# Also required for the isolated judge practice rate-limit key.
WORKER_SECRET=
# testnet for public testnet; regtest ONLY for an isolated local Z3 stack.
ZCASH_NETWORK=testnet
# Required for production signup. Without this, production registration returns 503.
EMAIL_VERIFICATION_MODE=disabled
RESEND_API_KEY=
EMAIL_FROM=ShadowBid <verify@your-verified-domain.example>
PUBLIC_APP_URL=https://your-shadowbid-domain.example

# Local development only. NEVER set these in Vercel production.
ALLOW_SHORT_AUCTIONS=true
# The Demo Domain Catalog is bundled static content; no sample database seed exists.
TEST_USER_SEED_ENABLED=false
LOCAL_AUTH_BYPASS=false

# Wallet worker only. Keep RPC credentials, wallet data, and keys away from Vercel.
SHADOWBID_APP_URL=http://127.0.0.1:3000
ZALLET_RPC_URL=http://127.0.0.1:40232
ZALLET_RPC_USER=
ZALLET_RPC_PASSWORD=
# Recommended for testnet, required for regtest chain cross-checking.
ZEBRA_RPC_URL=http://127.0.0.1:18232
ZEBRA_RPC_USER=
ZEBRA_RPC_PASSWORD=

# Optional, local-only test accounts; never set in Vercel.
TEST_SELLER_EMAIL=
TEST_SELLER_PASSWORD=
TEST_BIDDER_A_EMAIL=
TEST_BIDDER_A_PASSWORD=
TEST_BIDDER_B_EMAIL=
TEST_BIDDER_B_PASSWORD=

# Regtest integration script only; all endpoints and DATABASE_URL must point to loopback.
REGTEST_E2E_ENABLED=false
REGTEST_COINBASE_ADDRESS=
# Optional browser test overrides.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
# Required only when browser tests write to a disposable loopback PostgreSQL database.
E2E_ISOLATED_DB=false
